{
  "version": 2,
  "width": 256,
  "height": 256,
  "frames": 80,
  "frameDurationMs": 50,
  "loopDurationMs": 4000,
  "animatedFormat": "gif",
  "staticFormat": "png",
  "background": "#000000",
  "opaque": true,
  "providers": [
    "codex",
    "claude",
    "opencode"
  ],
  "states": [
    "working",
    "thinking",
    "waiting",
    "idle"
  ],
  "combined": "both-working",
  "combinedStates": [
    "working",
    "thinking",
    "waiting",
    "idle"
  ],
  "modelArt": {
    "provider": "opencode",
    "models": [
      "glm",
      "deepseek"
    ],
    "pattern": "{model}-{state}",
    "defaultPattern": "opencode-{state}"
  },
  "sources": {
    "brands": "simple-icons@develop + lobehub/icons@1.102.0",
    "opencode": "simple-icons",
    "deepseek": "simple-icons",
    "glm": "lobehub/icons (chatglm)"
  },
  "actionBadges": {
    "width": 128,
    "height": 128,
    "frames": 48,
    "frameDurationMs": 50,
    "loopDurationMs": 2400,
    "actions": [
      "working",
      "thinking",
      "editing",
      "reading",
      "searching",
      "testing",
      "terminal",
      "browsing",
      "reviewing",
      "waiting",
      "done",
      "idle"
    ]
  },
  "split": {
    "pattern": "split-{codexState}-{claudeState}",
    "axis": "vertical",
    "left": "codex",
    "right": "claude",
    "states": [
      "working",
      "thinking",
      "waiting"
    ],
    "width": 256,
    "height": 256,
    "frames": 80,
    "frameDurationMs": 50,
    "loopDurationMs": 4000
  }
}
