{
  "version": 3,
  "style": "pixel art",
  "width": 256,
  "height": 256,
  "frames": 16,
  "frameDurationMs": 120,
  "loopDurationMs": 1920,
  "animatedFormat": "gif",
  "staticFormat": "png",
  "opaque": true,
  "providers": [
    "codex",
    "claude",
    "opencode"
  ],
  "states": [
    "working",
    "thinking",
    "waiting",
    "idle"
  ],
  "characters": {
    "claude": "clawd",
    "codex": "codex pet",
    "deepseek": "whale",
    "opencode": "opencode mark",
    "glm": "z.ai mark"
  },
  "combined": "both-working",
  "combinedStates": [
    "working",
    "thinking",
    "waiting",
    "idle"
  ],
  "modelArt": {
    "provider": "opencode",
    "models": [
      "glm",
      "deepseek"
    ],
    "pattern": "{model}-{state}",
    "defaultPattern": "opencode-{state}"
  },
  "actionBadges": {
    "width": 128,
    "height": 128,
    "frames": 16,
    "frameDurationMs": 120,
    "loopDurationMs": 1920,
    "actions": [
      "working",
      "thinking",
      "editing",
      "reading",
      "searching",
      "testing",
      "terminal",
      "browsing",
      "reviewing",
      "waiting",
      "done",
      "idle"
    ]
  },
  "split": {
    "pattern": "split-{codexState}-{claudeState}",
    "left": "codex",
    "right": "claude",
    "states": [
      "working",
      "thinking",
      "waiting"
    ],
    "width": 256,
    "height": 256,
    "frames": 16,
    "frameDurationMs": 120,
    "loopDurationMs": 1920
  }
}
